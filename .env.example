# ==============================================================================
# ResqOps: SRE Incident Response & Post-Mortem Agent with Hindsight Memory
# ==============================================================================

# Hindsight Configuration
# Get your API key and instance at: https://ui.hindsight.vectorize.io
# Tip: Use promo code MEMHACK99 in the billing section for $50 free credits!
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sre-production-incidents

# LLM Provider Configuration
# Option A: Groq (Recommended - Super fast & generous free tier at https://groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini API (Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
